# ---- Server ----
PORT=5000
NODE_ENV=development
# Proxy hops to trust for client IP (rate limiting). 0 locally; set 1 on Render/Cloudflare.
TRUST_PROXY=0

# Frontend origin allowed by CORS (must match where Next.js runs)
CLIENT_URL=http://localhost:3000

# ---- Database ----
# MongoDB Atlas connection string
MONGO_URI=

# ---- Auth (JWT in httpOnly cookie) ----
# Use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---- Email (SMTP via Nodemailer) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Buzzap <hello@buzzaphq.com>"
# Where new-lead notifications go (defaults to SMTP_USER if unset)
LEADS_NOTIFY_EMAIL=
# Optional email destination for in-app notifications (messages, projects, assets)
NOTIFY_EMAIL_ALERTS_TO=

# ---- File storage (Cloudinary) — used by a later milestone ----
CLOUDINARY_URL=

# ---- Admin seed (used by `npm run seed` to create the single admin) ----
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin
# Auto-create the admin on startup (set true on hosts without shell access, e.g. Render free tier)
SEED_ADMIN_ON_START=false

# Set true when the frontend and API are on different domains (e.g. Vercel + Render).
# Makes the auth cookie sameSite=none; secure so the browser sends it cross-site.
COOKIE_CROSS_SITE=false
